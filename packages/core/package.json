{
  "name": "@textfilters/core",
  "version": "0.5.0",
  "type": "module",
  "description": "Small TypeScript contracts and composition helpers for text filters and actor-aware moderation.",
  "license": "MIT",
  "keywords": [
    "text-filtering",
    "content-moderation",
    "moderation",
    "typescript",
    "javascript",
    "censoring",
    "redaction",
    "pipeline",
    "text-processing",
    "range-masking"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "prettier README.md package.json src tests --check",
    "format": "prettier README.md package.json src tests --write",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run",
    "smoke:dist": "node --input-type=module --eval \"const core = await import('./dist/index.js'); core.combineFilters().process('ok'); core.createModerationPipeline().process({ actorKey: 'smoke', text: 'ok' });\"",
    "check": "npm run lint && npm test && npm run build && npm run smoke:dist && npm run pack:dry-run"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/textfilters/textfilters.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/textfilters/textfilters/issues"
  },
  "homepage": "https://github.com/textfilters/textfilters/tree/main/packages/core#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
