{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "221ae7d2a9ca7cf92b83683e74c2e72e4ca5fa00",
  "release-type": "node",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "skip-changelog": true,
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore: release ${branch}",
  "always-link-local": true,
  "plugins": ["node-workspace"],
  "packages": {
    "packages/core": {
      "component": "core",
      "package-name": "@textfilters/core"
    },
    "packages/url": {
      "component": "url",
      "package-name": "@textfilters/url"
    },
    "packages/email": {
      "component": "email",
      "package-name": "@textfilters/email"
    },
    "packages/phone": {
      "component": "phone",
      "package-name": "@textfilters/phone"
    },
    "packages/profanity": {
      "component": "profanity",
      "package-name": "@textfilters/profanity",
      "release-as": "2.0.0"
    },
    "packages/profanity-ru": {
      "component": "profanity-ru",
      "package-name": "@textfilters/profanity-ru",
      "bump-minor-pre-major": true
    },
    "packages/profanity-en": {
      "component": "profanity-en",
      "package-name": "@textfilters/profanity-en",
      "bump-minor-pre-major": true
    },
    "packages/spam": {
      "component": "spam",
      "package-name": "@textfilters/spam"
    }
  }
}
