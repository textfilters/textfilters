{
  "name": "textfilters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Textfilters monorepo for independently versioned TypeScript text filtering packages.",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/url",
    "packages/email",
    "packages/phone",
    "packages/profanity",
    "packages/profanity-ru",
    "packages/profanity-en",
    "packages/spam"
  ],
  "scripts": {
    "benchmark": "node scripts/benchmark.mjs",
    "build:profanity-dictionaries": "node scripts/build-profanity-dictionary.mjs",
    "build": "node scripts/run-workspace-script.mjs build",
    "check": "npm run check:metadata && npm run check:release-paths && npm run test:profanity-builder && npm run check:workspaces && npm run test:profanity-integration && npm run smoke:tarballs",
    "check:metadata": "node scripts/check-monorepo-metadata.mjs",
    "check:release-paths": "node scripts/publish-released-workspaces.mjs --self-test",
    "check:workspaces": "node scripts/run-workspace-script.mjs check",
    "lint": "node scripts/run-workspace-script.mjs lint",
    "pack:dry-run": "node scripts/run-workspace-script.mjs pack:dry-run",
    "smoke:dist": "node scripts/run-workspace-script.mjs smoke:dist",
    "smoke:tarballs": "node scripts/smoke-tarball-consumer.mjs",
    "test": "npm run test:profanity-builder && node scripts/run-workspace-script.mjs test && npm run test:profanity-integration",
    "test:profanity-builder": "node scripts/test-profanity-builder.mjs",
    "test:profanity-integration": "node scripts/test-profanity-integration.mjs"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.16.0"
}
